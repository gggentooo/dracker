<!--
  File:         packaging/macos/entitlements.plist
  Phase:        Phase 9.1 — Hardened Runtime Code Signing Entitlements
  Purpose:
    Grants live audio-input access under macOS Hardened Runtime without enabling
    unsafe JIT or unsigned executable memory entitlements.
-->
