/**
 * File:         source/graph/module_api.d
 * Module:       graph.module_api
 * Phase:        Phase 2.2 — Compile-Time @Param UDA Protocol & ModuleAdapter!T
 *
 * Purpose:
 *   Extracts parameter metadata, port descriptors, NaN-free init assertions, named onParamChanged!field dispatch, and optional serializeExtra/swapAsset hooks from any module struct into a static ModuleVTable.
 *
 * Real-Time & Safety Contract:
 *   Compile-time reflection + @nogc nothrow ModuleVTable wrappers; enforces assertNoNaNInit!T() and zero GC references at build time.
 *
 * Dependencies:
 *   Internal: foundation.types, foundation.concurrency, graph.port, graph.context, graph.event, graph.buffer
 *   External: core.lifetime (emplace), core.stdc.stdlib (free, malloc), core.sys.posix.stdlib (posix_memalign), std.math (isNaN), std.traits
 *
 * Planned API (Types, Functions & Hooks):
 *   - enum ParamScale : ubyte { linear, logarithmic, discrete }
 *   - enum ModuleCategory : ubyte { core, synth, effect, control }
 *   - struct Param / struct ParamDescriptor / struct ModuleDescriptor / struct ModuleVTable / struct ModuleInstance
 *   - void assertNoNaNInit(T)()
 *   - template ModuleAdapter(T)
 *
 * See_Also:
 *   architecture_proposal.md, dev_plan_proposal.md
 */
module graph.module_api;

import core.lifetime : emplace;
import core.stdc.stdlib : free, malloc;
version (Posix) import core.sys.posix.stdlib : posix_memalign;
import std.math : exp, isFinite, isNaN, log;
import std.traits : FieldNameTuple, getUDAs, hasElaborateDestructor, hasUDA, isFloatingPoint,
    isStaticArray;

import foundation.concurrency : hasGcReference;
import foundation.types : DEFAULT_SIMD_ALIGNMENT, ModuleId;
import graph.buffer : ProcessIO;
import graph.context : ProcessContext;
import graph.event : ModEvent;
import graph.port : PortDescriptor;

/**
 * UI and automation scaling curve for a module parameter.
 */
enum ParamScale : ubyte {
    linear = 0,
    logarithmic = 1,
    discrete = 2
}

/**
 * High-level studio module classification used for registry menus and color coding.
 */
enum ModuleCategory : ubyte {
    core = 0,
    synth = 1,
    effect = 2,
    control = 3
}

/**
 * User-defined attribute marking a float field on a module struct as an automatable parameter.
 */
struct Param {
    string name;
    float minVal = 0.0f;
    float maxVal = 1.0f;
    float defaultVal = 0.0f;
    string unit = "";
    ParamScale scale = ParamScale.linear;
}

/**
 * Immutable compile-time descriptor extracted from a module's @Param annotated float fields.
 */
struct ParamDescriptor {
    uint index = 0;
    string fieldName;
    string name;
    float minVal = 0.0f;
    float maxVal = 1.0f;
    float defaultVal = 0.0f;
    string unit;
    ParamScale scale = ParamScale.linear;
}

/**
 * Type-erased @nogc function table generated by ModuleAdapter!T for RT and off-RT dispatch.
 */
struct ModuleVTable {
    void* function() @nogc nothrow create;
    void function(void*) @nogc nothrow destroy;
    void function(void*, float sampleRate, uint maxSliceFrames) @nogc nothrow prepare;
    void function(void*) @nogc nothrow reset;
    void function(void*, scope const ref ModEvent ev, float sampleRate) @nogc nothrow handleEvent;
    bool function(void*, ref ProcessIO io, ref ProcessContext ctx) @nogc nothrow process;
    void function(void*, const(float[])[2] audioIn, ref ProcessContext ctx) @nogc nothrow processFeedbackSend;
    float function(const(void)*, uint paramIdx) @nogc nothrow getParam;
    bool function(void*, uint paramIdx, float val, float sampleRate, bool instant) @nogc nothrow setParam;
    bool function(void*, uint paramIdx, float norm01, float sampleRate, bool instant) @nogc nothrow setParamNormalized;
    bool function(void*, uint slot, void* newAsset, out void* oldAsset) @nogc nothrow swapAsset;
    bool function(const(void)*, out ubyte[] payload) serializeExtra;
    bool function(void*, const(ubyte)[] payload, float sampleRate) deserializeExtra;
}

/**
 * Static metadata descriptor uniquely identifying a registered built-in module type.
 */
struct ModuleDescriptor {
    string typeId;
    string displayName;
    ModuleCategory category = ModuleCategory.effect;
    immutable(PortDescriptor)[] ports;
    immutable(ParamDescriptor)[] params;
    immutable(ModuleVTable)* vtable = null;
    size_t stateSize = 0;
    size_t stateAlign = 0;
    bool isFeedback = false;
    bool isOutput = false;
}

/**
 * Off-RT owning handle pairing a graph ModuleId with an instantiated module state pointer.
 */
struct ModuleInstance {
    ModuleId id = ModuleId.invalid;
    const(ModuleDescriptor)* desc = null;
    void* state = null;

    /**
     * Destroys and frees the underlying @nogc module state pointer off the audio thread.
     */
    void destroyOffRT() @nogc nothrow {
        if (state !is null && desc !is null && desc.vtable !is null && desc.vtable.destroy !is null) {
            desc.vtable.destroy(state);
        }
        state = null;
        desc = null;
        id = ModuleId.invalid;
    }
}

private void checkNoNaNValue(T)(ref const T val) {
    static if (isFloatingPoint!T) {
        assert(!isNaN(val), "Floating-point field defaults to NaN in " ~ T.stringof);
    } else static if (isStaticArray!T) {
        alias Elem = typeof(T.init[0]);
        static if (isFloatingPoint!Elem) {
            foreach (e; val) {
                assert(!isNaN(e), "Static floating-point array element defaults to NaN in " ~ T.stringof);
            }
        } else static if (is(Elem == struct) || isStaticArray!Elem) {
            foreach (ref e; val) {
                checkNoNaNValue!Elem(e);
            }
        }
    } else static if (is(T == struct)) {
        static foreach (fieldName; FieldNameTuple!T) {
            checkNoNaNValue!(typeof(__traits(getMember, val, fieldName)))(
                __traits(getMember, val, fieldName)
            );
        }
    }
}

/**
 * Compile-time assertion verifying that no floating-point field in T.init defaults to NaN.
 *
 * Inspects scalars, static arrays, and nested structs recursively without copying
 * non-copyable member fields.
 */
void assertNoNaNInit(T)() {
    enum bool allFinite = () {
        T defVal;
        checkNoNaNValue!T(defVal);
        return true;
    }();
    static assert(allFinite, "Module " ~ T.stringof ~ " contains uninitialized NaN floating-point fields");
}

private size_t countParamFields(T)() {
    size_t count = 0;
    static foreach (fieldName; FieldNameTuple!T) {
        static if (hasUDA!(__traits(getMember, T, fieldName), Param)) {
            count++;
        }
    }
    return count;
}

private ParamDescriptor[N] buildParamDescriptors(T, size_t N)() {
    ParamDescriptor[N] result;
    size_t idx = 0;
    static foreach (fieldName; FieldNameTuple!T) {
        static if (hasUDA!(__traits(getMember, T, fieldName), Param)) {
            static assert(
                is(typeof(__traits(getMember, T, fieldName)) == float),
                "@Param field " ~ T.stringof ~ "." ~ fieldName ~ " must be float"
            );
            {
                enum Param p = getUDAs!(__traits(getMember, T, fieldName), Param)[0];
                result[idx] = ParamDescriptor(
                    cast(uint) idx,
                    fieldName,
                    p.name,
                    p.minVal,
                    p.maxVal,
                    p.defaultVal,
                    p.unit,
                    p.scale
                );
                idx++;
            }
        }
    }
    return result;
}

/**
 * Compile-time adapter generating @nogc ModuleVTable and ModuleDescriptor bindings for module T.
 *
 * Enforces zero GC indirections, NaN-free default initialization, static port metadata, and
 * field-name-dispatched parameter change hooks.
 */
template ModuleAdapter(T) {
    static assert(is(T == struct), "ModuleAdapter requires a struct module type");
    static assert(!hasGcReference!T,
        "Module " ~ T.stringof ~ " cannot hold GC-managed references on the RT path");
    static assert(T.sizeof > 0, "Module " ~ T.stringof ~ " must have positive size");
    static assert(__traits(hasMember, T, "typeId") && is(typeof(T.typeId) : string),
        "Module " ~ T.stringof ~ " must define enum/static string typeId");
    static assert(__traits(hasMember, T, "displayName") && is(typeof(T.displayName) : string),
        "Module " ~ T.stringof ~ " must define enum/static string displayName");
    static assert(__traits(hasMember, T, "ports") && is(typeof(T.ports) : const(PortDescriptor)[]),
        "Module " ~ T.stringof ~ " must define static immutable PortDescriptor[] ports");

    static if (hasElaborateDestructor!T) {
        static assert(
            __traits(compiles, (ref T m) @nogc nothrow { destroy!false(m); }),
            "Module " ~ T.stringof ~ " destructor must be @nogc nothrow"
        );
    }

    private enum bool nanInitVerified_ = () {
        assertNoNaNInit!T();
        return true;
    }();
    static assert(nanInitVerified_);

    private enum size_t PARAM_COUNT = countParamFields!T();
    static if (PARAM_COUNT > 0) {
        static immutable ParamDescriptor[PARAM_COUNT] PARAM_STORAGE = buildParamDescriptors!(T, PARAM_COUNT)();
        static immutable immutable(ParamDescriptor)[] PARAM_SLICE = PARAM_STORAGE[];
    } else {
        static immutable immutable(ParamDescriptor)[] PARAM_SLICE = [];
    }

    static if (__traits(hasMember, T, "category") && is(typeof(T.category) : ModuleCategory)) {
        private enum ModuleCategory MODULE_CATEGORY = T.category;
    } else {
        private enum ModuleCategory MODULE_CATEGORY = ModuleCategory.effect;
    }

    static if (__traits(hasMember, T, "isOutputModule") && is(typeof(T.isOutputModule) == bool)) {
        private enum bool IS_OUTPUT = T.isOutputModule;
    } else {
        private enum bool IS_OUTPUT = false;
    }

    private enum bool HAS_FEEDBACK_SEND = __traits(
        compiles,
        (ref T m, const(float[])[2] aIn, ref ProcessContext ctx) @nogc nothrow {
            m.processFeedbackSend(aIn, ctx);
        }
    );

    private void* createImpl() @nogc nothrow {
        enum size_t allocAlign = T.alignof > DEFAULT_SIMD_ALIGNMENT ? T.alignof : DEFAULT_SIMD_ALIGNMENT;
        void* mem = null;
        version (Posix) {
            if (posix_memalign(&mem, allocAlign, T.sizeof) != 0 || mem is null) {
                return null;
            }
        } else {
            mem = malloc(T.sizeof);
            if (mem is null) {
                return null;
            }
        }
        auto typed = cast(T*) mem;
        emplace(typed);
        return mem;
    }

    private void destroyImpl(void* raw) @nogc nothrow {
        if (raw is null) {
            return;
        }
        auto typed = cast(T*) raw;
        destroy!false(*typed);
        free(raw);
    }

    private void prepareImpl(void* raw, float sampleRate, uint maxSliceFrames) @nogc nothrow {
        if (raw is null) {
            return;
        }
        auto mod = cast(T*) raw;
        static if (__traits(compiles, (ref T m, float sr, uint mf) @nogc nothrow { m.prepare(sr, mf); })) {
            mod.prepare(sampleRate, maxSliceFrames);
        } else static if (__traits(compiles, (ref T m, float sr) @nogc nothrow { m.prepare(sr); })) {
            mod.prepare(sampleRate);
        }
    }

    private void resetImpl(void* raw) @nogc nothrow {
        if (raw is null) {
            return;
        }
        auto mod = cast(T*) raw;
        static if (__traits(compiles, (ref T m) @nogc nothrow { m.reset(); })) {
            mod.reset();
        }
    }

    private void handleEventImpl(void* raw, scope const ref ModEvent ev, float sampleRate) @nogc nothrow {
        if (raw is null) {
            return;
        }
        auto mod = cast(T*) raw;
        static if (__traits(compiles, (ref T m, scope const ref ModEvent e, float sr) @nogc nothrow {
            m.handleEvent(e, sr);
        })) {
            mod.handleEvent(ev, sampleRate);
        } else static if (__traits(compiles, (ref T m, scope const ref ModEvent e) @nogc nothrow {
            m.handleEvent(e);
        })) {
            mod.handleEvent(ev);
        }
    }

    private bool processImpl(void* raw, ref ProcessIO io, ref ProcessContext ctx) @nogc nothrow {
        if (raw is null) {
            return false;
        }
        auto mod = cast(T*) raw;
        static if (__traits(compiles, (ref T m, ref ProcessIO pio, ref ProcessContext pctx) @nogc nothrow {
            bool b = m.process(pio, pctx);
        })) {
            return mod.process(io, ctx);
        } else static if (__traits(compiles, (
            ref T m,
            const(float[])[2] aIn,
            float[][2] aOut,
            ref ProcessContext pctx
        ) @nogc nothrow {
            bool b = m.process(aIn, aOut, pctx);
        })) {
            return mod.process(io.audioIn, io.audioOut, ctx);
        } else static if (__traits(compiles, (ref T m, ref ProcessContext pctx) @nogc nothrow {
            bool b = m.process(pctx);
        })) {
            return mod.process(ctx);
        } else {
            static assert(false, "Module " ~ T.stringof ~ " must implement a @nogc nothrow process() method");
        }
    }

    private void processFeedbackSendImpl(
        void* raw,
        const(float[])[2] audioIn,
        ref ProcessContext ctx
    ) @nogc nothrow {
        static if (HAS_FEEDBACK_SEND) {
            if (raw is null) {
                return;
            }
            auto mod = cast(T*) raw;
            mod.processFeedbackSend(audioIn, ctx);
        } else {
            cast(void) raw;
            cast(void) audioIn;
            cast(void) ctx;
        }
    }

    private float getParamImpl(const(void)* raw, uint paramIdx) @nogc nothrow {
        if (raw is null) {
            return 0.0f;
        }
        auto mod = cast(const(T)*) raw;
        static if (PARAM_COUNT > 0) {
            static foreach (i; 0 .. PARAM_COUNT) {
                if (paramIdx == i) {
                    return __traits(getMember, *mod, PARAM_STORAGE[i].fieldName);
                }
            }
        }
        return 0.0f;
    }

    private bool setParamImpl(
        void* raw,
        uint paramIdx,
        float val,
        float sampleRate,
        bool instant
    ) @nogc nothrow {
        if (raw is null || paramIdx >= PARAM_COUNT) {
            return false;
        }
        auto mod = cast(T*) raw;
        static if (PARAM_COUNT > 0) {
            static foreach (i; 0 .. PARAM_COUNT) {
                if (paramIdx == i) {
                    {
                        enum ParamDescriptor desc = PARAM_STORAGE[i];
                        float clamped = isFinite(val) ? val : desc.defaultVal;
                        if (clamped < desc.minVal) {
                            clamped = desc.minVal;
                        } else if (clamped > desc.maxVal) {
                            clamped = desc.maxVal;
                        }
                        __traits(getMember, *mod, desc.fieldName) = clamped;
                        static if (__traits(compiles, (ref T m, float sr, bool inst) @nogc nothrow {
                            m.onParamChanged!(desc.fieldName)(sr, inst);
                        })) {
                            mod.onParamChanged!(desc.fieldName)(sampleRate, instant);
                        } else static if (__traits(compiles, (ref T m, float sr) @nogc nothrow {
                            m.onParamChanged!(desc.fieldName)(sr);
                        })) {
                            mod.onParamChanged!(desc.fieldName)(sampleRate);
                        }
                        return true;
                    }
                }
            }
        }
        return false;
    }

    private bool setParamNormalizedImpl(
        void* raw,
        uint paramIdx,
        float norm01,
        float sampleRate,
        bool instant
    ) @nogc nothrow {
        if (raw is null || paramIdx >= PARAM_COUNT) {
            return false;
        }
        float n = isFinite(norm01) ? norm01 : 0.0f;
        if (n < 0.0f) {
            n = 0.0f;
        } else if (n > 1.0f) {
            n = 1.0f;
        }
        static if (PARAM_COUNT > 0) {
            static foreach (i; 0 .. PARAM_COUNT) {
                if (paramIdx == i) {
                    {
                        enum ParamDescriptor desc = PARAM_STORAGE[i];
                        float mapped = desc.defaultVal;
                        if (desc.scale == ParamScale.logarithmic && desc.minVal > 0.0f && desc.maxVal > desc.minVal) {
                            immutable double ratio = cast(double) desc.maxVal / cast(double) desc.minVal;
                            mapped = cast(float)(cast(double) desc.minVal * exp(log(ratio) * cast(double) n));
                        } else if (desc.scale == ParamScale.discrete) {
                            immutable float span = desc.maxVal - desc.minVal;
                            immutable int step = cast(int)(n * span + 0.5f);
                            mapped = desc.minVal + cast(float) step;
                        } else {
                            mapped = desc.minVal + (desc.maxVal - desc.minVal) * n;
                        }
                        return setParamImpl(raw, paramIdx, mapped, sampleRate, instant);
                    }
                }
            }
        }
        return false;
    }

    private bool swapAssetImpl(void* raw, uint slot, void* newAsset, out void* oldAsset) @nogc nothrow {
        oldAsset = null;
        if (raw is null) {
            return false;
        }
        auto mod = cast(T*) raw;
        static if (__traits(compiles, (ref T m, uint s, void* n, out void* o) @nogc nothrow {
            bool ok = m.swapAsset(s, n, o);
        })) {
            return mod.swapAsset(slot, newAsset, oldAsset);
        } else {
            return false;
        }
    }

    private bool serializeExtraImpl(const(void)* raw, out ubyte[] payload) {
        payload = null;
        if (raw is null) {
            return false;
        }
        auto mod = cast(const(T)*) raw;
        static if (__traits(compiles, (const ref T m, out ubyte[] p) { bool ok = m.serializeExtra(p); })) {
            return mod.serializeExtra(payload);
        } else {
            return true;
        }
    }

    private bool deserializeExtraImpl(void* raw, const(ubyte)[] payload, float sampleRate) {
        if (raw is null) {
            return false;
        }
        auto mod = cast(T*) raw;
        static if (__traits(compiles, (ref T m, const(ubyte)[] p, float sr) {
            bool ok = m.deserializeExtra(p, sr);
        })) {
            return mod.deserializeExtra(payload, sampleRate);
        } else {
            cast(void) payload;
            cast(void) sampleRate;
            return true;
        }
    }

    static immutable ModuleVTable VTABLE = ModuleVTable(
        &createImpl,
        &destroyImpl,
        &prepareImpl,
        &resetImpl,
        &handleEventImpl,
        &processImpl,
        HAS_FEEDBACK_SEND ? &processFeedbackSendImpl : null,
        &getParamImpl,
        &setParamImpl,
        &setParamNormalizedImpl,
        &swapAssetImpl,
        &serializeExtraImpl,
        &deserializeExtraImpl
    );

    static immutable ModuleDescriptor DESCRIPTOR = ModuleDescriptor(
        T.typeId,
        T.displayName,
        MODULE_CATEGORY,
        T.ports,
        PARAM_SLICE,
        &VTABLE,
        T.sizeof,
        T.alignof,
        HAS_FEEDBACK_SEND,
        IS_OUTPUT
    );
}
